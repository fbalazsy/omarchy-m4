#!/bin/sh
# 1TR bootstrap for the SSH hold Mach-O. Set H to the recovery server.
# Does not reboot. Does not write the ESP or the Linux root.
set -eu
H=${H:?set H to the recovery server}
curl -fsS --max-time 60 -o /tmp/enroll-v2 "$H/enroll-v2"
curl -fsS --max-time 30 -o /tmp/m4ssh.pins "$H/m4ssh.pins"
exec sh /tmp/enroll-v2 /tmp/m4ssh.pins
