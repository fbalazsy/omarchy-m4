#!/bin/sh
# 1TR bootstrap for the normal-boot Mach-O on the g55obs2 kernel.
# Set H to the recovery server. Does not reboot. Does not write the ESP.
set -eu
H=${H:?set H to the recovery server}
curl -fsS --max-time 60 -o /tmp/enroll-v2 "$H/enroll-v2"
curl -fsS --max-time 30 -o /tmp/m4boot.pins "$H/m4boot.pins"
exec sh /tmp/enroll-v2 /tmp/m4boot.pins
