# Session environment for the GPU desktop, from the m4-aurora-mesa package (m4-support links /usr/lib/m4/session-env to it).
LD_LIBRARY_PATH=/opt/aurora-mesa/lib
GBM_BACKENDS_PATH=/opt/aurora-mesa/lib/gbm
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/aurora-mesa/share/glvnd/egl_vendor.d/50_mesa.json
MESA_GLTHREAD=false
# 1queue: a second render queue in a process makes the 25G83 firmware assert ("PBState must be unbind").
# nocompress: with compression the compositor's full-screen render failed (EIO) under vkmark (2026-10-19).
ASAHI_MESA_DEBUG=1queue,nocompress
VK_DRIVER_FILES=/opt/aurora-mesa/share/vulkan/icd.d/asahi_icd.aarch64.json
# Ray tracing (acceleration structures, ray query, RT pipelines) is unqualified on T6040: dEQP's RT cases crash, and one
# stalled the GPU without a firmware recovery so the timeout failed every client and Hyprland aborted (2026-10-19).
ASAHI_G17P_RT_DISABLE=1
GDK_BACKEND=wayland
GSK_RENDERER=gl
GDK_DISABLE=vulkan
QT_QPA_PLATFORM=wayland
QT_WAYLAND_CLIENT_BUFFER_INTEGRATION=wayland-egl
QT_WAYLAND_DISABLE_WINDOWDECORATION=1
QSG_RHI_BACKEND=opengl
QSG_RENDER_LOOP=basic
AQ_NO_MODIFIERS=1
