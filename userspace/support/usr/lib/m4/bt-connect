#!/usr/bin/python3 -B
"""m4-bt-connect.service: connect the configured headset after bluetoothd is up. The BlueZ info file (written by bt-keyshare) carries
Trusted=true, so the headset's own reconnect is accepted; this helper covers the case where the headset is already on at boot.
Retries for up to 180 s; an authentication rejection tries the shared key's other byte order once (bt_keyshare.alternate). Exit 0 always.

/etc/m4/bluetooth.conf: `device=XX:XX:XX:XX:XX:XX`; empty or absent: nothing to connect."""
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, '/usr/lib/m4')
import bt_keyshare as ks   # noqa: E402

CONF = Path('/etc/m4/bluetooth.conf')
DEADLINE_S = 180.0


def configured_device():
    try:
        for line in CONF.read_text().splitlines():
            key, _, value = line.partition('=')
            if key.strip() == 'device' and value.strip():
                return value.strip()
    except OSError:
        pass
    return ''


def main():
    device = configured_device()
    if not device:
        print('M4_BT_CONNECT no device configured', flush=True)
        return 0
    end = time.monotonic() + DEADLINE_S
    tried = []
    while time.monotonic() < end:
        started = time.monotonic()
        p = subprocess.run(['/usr/bin/bluetoothctl', '--timeout', '20', 'connect', device], capture_output=True, text=True)
        text = p.stdout + p.stderr
        if 'Connection successful' in text:
            print('M4_BT_CONNECT connected', flush=True)
            return 0
        if ks.is_auth_rejection(text, time.monotonic() - started):
            try:
                alt = ks.alternate(tried=tried)
                if alt:
                    tried.append(alt['order'])
                    ks.install_key(alt['key'], alt['type'])
                    ks.load_into_kernel(0, alt['key'], alt['type'])
                    print('M4_BT_CONNECT trying the other key order', flush=True)
            except Exception as error:   # noqa: BLE001 -- never fail the boot
                print('M4_BT_CONNECT key retry failed: %s' % str(error)[-200:], flush=True)
        time.sleep(5)
    print('M4_BT_CONNECT not connected after %d s' % DEADLINE_S, flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
