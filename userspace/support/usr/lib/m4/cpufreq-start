#!/usr/bin/python3 -IB
"""m4-cpufreq.service: CPU frequency scaling (gaps G1). Every check must pass before anything is written; on any failure
the clusters stay at p-state 1 (the kernel's default governor is powersave, and apple_soc_cpufreq writes nothing at load).

  1. macsmc_hwmon, then the cpu-die-thermal zone: TCMz (CPU die max) readable and sane, the 113 C passive trip set
  2. apple_soc_cpufreq, then the three cluster policies (P0, E, P1) bound to the zone as cooling devices. Logical CPU
     numbers follow the device tree's CPU node order, so the clusters are read back, never assumed: E is the policy
     with the lower top frequency, P0 the P policy holding CPU 0 (since 7.3.0-m4.9: P0 0,5-8 / E 1-4 / P1 9-13).
  3. scaling_max_freq of each policy = its cap (a table frequency), THEN the schedutil governor

Default: no caps (each policy's top table frequency). Optional /etc/m4/cpufreq.conf sets lower ones:
                        P_MAX_KHZ=2616000   E_MAX_KHZ=2112000   (one per line; the old capped interim)
Attended evidence for the interim caps: all 14 cores busy for 300 s held TCMz at 87-88 C (peak 89.1) at 40-45 W, the fans
started on their own after 2-3 min. Uncapped and without the PMP, the same load reached 100 C in 11 s, faster than any
trip on TCMz can act. Since the kernel that starts the PMP at boot, its fast die-temperature limit regulates the clusters
(a kernel QoS maximum below scaling_max_freq; attended 2026-10-19, all cores busy, no caps: TCMz settled at 111.3 C with
the fans at macOS's speed). The zone's 113 C passive and 118 C critical trips are the backstop, and while the PMP is not
running the kernel holds each cluster at its fastest state that draws at most a third of the top state's power
(apple-soc-cpufreq.c).
"""
import os
import re
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(os.environ.get('M4_CPUFREQ_ROOT', '/'))        # tests point this at a fake tree
CONF = 'etc/m4/cpufreq.conf'
CPUFREQ = 'sys/devices/system/cpu/cpufreq'
THERMAL = 'sys/class/thermal'
CLUSTER_CPUS = {'P': 5, 'E': 4}                            # 2 x 5 P-cores + 4 E-cores
NCPUS = 2 * CLUSTER_CPUS['P'] + CLUSTER_CPUS['E']
TRIP_MC = 113000
WAIT_S = 10.0


class Refused(Exception):
    pass


def say(text):
    print('m4-cpufreq: ' + text, flush=True)


def read(path):
    try:
        return (ROOT/path).read_text().strip()
    except OSError:
        return None


def write(path, value):
    (ROOT/path).write_text(str(value))


def conf():
    """The optional caps by cluster kind ('P', 'E'), or None: no caps."""
    text = read(CONF)
    if text is None:
        return None
    values = {}
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        m = re.fullmatch(r'([PE])_MAX_KHZ\s*=\s*(\d+)', line)
        if not m:
            raise Refused('unreadable line in %s: %r' % ('/' + CONF, line))
        values[m.group(1)] = int(m.group(2))
    if set(values) != {'P', 'E'}:
        raise Refused('%s needs P_MAX_KHZ and E_MAX_KHZ' % ('/' + CONF))
    return values


def modprobe(name, run):
    rc = run(['/usr/bin/modprobe', name])
    if rc != 0:
        raise Refused('modprobe %s failed (rc %s)' % (name, rc))


def wait_for(probe, what, sleep):
    deadline = time.monotonic() + WAIT_S
    while True:
        value = probe()
        if value:
            return value
        if time.monotonic() >= deadline:
            raise Refused('%s did not appear within %d s' % (what, WAIT_S))
        sleep(0.2)


def zone():
    base = ROOT/THERMAL
    for z in sorted(base.glob('thermal_zone*')) if base.is_dir() else []:
        if read(z.relative_to(ROOT)/'type') == 'cpu-die-thermal':
            return z.relative_to(ROOT)
    return None


def bound_cdevs(z):
    out = set()
    for link in (ROOT/z).iterdir():
        if re.fullmatch(r'cdev\d+', link.name):
            t = read(Path(os.path.realpath(link)).relative_to(os.path.realpath(ROOT)) / 'type')
            if t:
                out.add(t)
    return out


def clusters():
    """{'P0'|'E'|'P1': (policy, cpus, kind, table)} once exactly three policies with tables exist, else None."""
    base = ROOT/CPUFREQ
    found = []
    for d in sorted(base.glob('policy*')) if base.is_dir() else []:
        rel = d.relative_to(ROOT)
        cpus = [int(x) for x in (read(rel/'related_cpus') or '').split()]
        table = [int(x) for x in (read(rel/'scaling_available_frequencies') or '').split()]
        if not cpus or not table:
            return None
        found.append((d.name, cpus, table))
    if len(found) != 3:
        return None
    found.sort(key=lambda f: max(f[2]))
    (e, p_a, p_b) = found
    p0, p1 = (p_a, p_b) if 0 in p_a[1] else (p_b, p_a)
    return {'P0': (p0[0], p0[1], 'P', p0[2]), 'E': (e[0], e[1], 'E', e[2]), 'P1': (p1[0], p1[1], 'P', p1[2])}


def check_clusters(policies):
    if max(policies['E'][3]) >= min(max(policies['P0'][3]), max(policies['P1'][3])):
        raise Refused('no policy has a lower top frequency than the others: cannot tell the E cluster')
    if 0 not in policies['P0'][1]:
        raise Refused('CPU 0 is not in a P cluster')
    every = sorted(c for _, cpus, _, _ in policies.values() for c in cpus)
    if every != list(range(NCPUS)):
        raise Refused('the policies cover CPUs %s, not 0-%d' % (every, NCPUS - 1))
    for name, (p, cpus, kind, _) in policies.items():
        if len(cpus) != CLUSTER_CPUS[kind] or p != 'policy%d' % min(cpus):
            raise Refused('%s %s covers CPUs %s, not one %s cluster of %d' % (name, p, cpus, kind, CLUSTER_CPUS[kind]))


def start(run=lambda argv: subprocess.run(argv).returncode, sleep=time.sleep):
    caps = conf()
    modprobe('macsmc_hwmon', run)
    z = wait_for(zone, 'the cpu-die-thermal zone (macsmc_hwmon, TCMz)', sleep)
    temp = read(z/'temp')
    if temp is None or not temp.lstrip('-').isdigit() or not 20000 <= int(temp) <= 100000:
        raise Refused('TCMz reads %r, not a die temperature' % temp)
    if read(z/'trip_point_0_type') != 'passive' or read(z/'trip_point_0_temp') != str(TRIP_MC):
        raise Refused('the cpu-die zone does not have its %d passive trip' % TRIP_MC)
    modprobe('apple_soc_cpufreq', run)
    policies = wait_for(clusters, 'the three cpufreq policies', sleep)
    check_clusters(policies)
    cdev_names = {'cpufreq-cpu%d' % min(cpus) for _, cpus, _, _ in policies.values()}
    for name, (p, cpus, kind, table) in policies.items():
        if caps is None or kind not in caps:
            caps = dict(caps or {}, **{kind: max(table)})
        if caps[kind] not in table:
            raise Refused('%s cap %d kHz is not one of %s' % (name, caps[kind], table))
    cdevs = wait_for(lambda: bound_cdevs(z) >= cdev_names and bound_cdevs(z), 'the zone binding to the three policies', sleep)
    if not cdev_names <= cdevs:
        raise Refused('the zone is bound to %s, not %s' % (sorted(cdevs), sorted(cdev_names)))
    for name, (p, _, kind, _) in policies.items():             # caps first: schedutil must never see the uncapped range
        write(Path(CPUFREQ)/p/'scaling_max_freq', caps[kind])
    # The write only updates a frequency QoS request; the kernel applies it to the policy in a deferred work item
    # (cpufreq_notifier_max -> schedule_work(&policy->update)), so an immediate read-back can still show the old maximum
    # (boot 2026-10-15 22:38: "P0 scaling_max_freq did not take" while the system was busy). Wait until every policy has it.
    # At or below the cap: the PMP's fast die-temperature limit (a kernel QoS maximum, CLPC lane) may already sit lower.
    wait_for(lambda: all(int(read(Path(CPUFREQ)/p/'scaling_max_freq')) <= caps[kind] for p, _, kind, _ in policies.values()),
             'the caps on all three policies (scaling_max_freq)', sleep)
    for name, (p, _, _, _) in policies.items():
        write(Path(CPUFREQ)/p/'scaling_governor', 'schedutil')
    say('schedutil on P0/E/P1, caps P %d kHz, E %d kHz; TCMz %.1f C, zone bound to %s' % (
        caps['P'], caps['E'], int(temp) / 1000, ', '.join(sorted(cdev_names))))
    return 0


def main():
    try:
        return start()
    except Refused as error:
        say('not started (the CPUs stay at the lowest p-state): %s' % error)
        return 1


if __name__ == '__main__':
    sys.exit(main())
