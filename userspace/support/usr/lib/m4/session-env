# Session environment of the GPU desktop (m4-support): toolkit renderer choices only. The GPU driver is the system Mesa
# (m4-aurora-mesa, m4-aurora-vulkan): no library paths, no driver selection, and the T6040's firmware workarounds
# (one queue, no compression) are driver defaults, so processes started outside this environment get them too.
MESA_GLTHREAD=false
GDK_BACKEND=wayland
GSK_RENDERER=gl
GDK_DISABLE=vulkan
QT_QPA_PLATFORM=wayland
QT_WAYLAND_CLIENT_BUFFER_INTEGRATION=wayland-egl
QT_WAYLAND_DISABLE_WINDOWDECORATION=1
QSG_RHI_BACKEND=opengl
QSG_RENDER_LOOP=basic
AQ_NO_MODIFIERS=1
