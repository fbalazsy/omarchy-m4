[Unit]
Description=M4 CPU frequency scaling (gaps G1; optional caps in /etc/m4/cpufreq.conf)
ConditionFirmware=device-tree-compatible(apple,j616s)
StartLimitIntervalSec=60
StartLimitBurst=3
ConditionKernelCommandLine=!m4.safe
ConditionVirtualization=!container
After=m4-boot-pending.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -IB /usr/lib/m4/cpufreq-start
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
