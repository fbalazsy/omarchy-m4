[Unit]
Description=M4 GPU: hold the sleep inhibitor while the GPU driver is loaded (suspend is not qualified)
ConditionFirmware=device-tree-compatible(apple,j616s)
StartLimitIntervalSec=60
StartLimitBurst=3
ConditionKernelCommandLine=!m4.safe
ConditionVirtualization=!container
After=m4-boot-pending.service
BindsTo=m4-gpu.service
After=m4-gpu.service
ConditionPathExists=/run/m4/gpu-ready

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=m4-gpu --why="the GPU driver does not suspend" --mode=block /usr/bin/sleep infinity

[Install]
WantedBy=graphical.target
